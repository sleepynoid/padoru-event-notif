---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getUniqueAreas } from '../../utils/eventUtils';

export async function getStaticPaths() {
	const events = await getCollection('eventMetadata');
	return events.map((event, index) => ({
		params: { slug: `event-${event.id.replace('event-', '')}` },
		props: { event, allEvents: events, index },
	}));
}

const { event, allEvents, index } = Astro.props;

const relatedEvents = allEvents
	.filter(e => e.data.area === event.data.area && e.id !== event.id)
	.slice(0, 3);
---

<BaseLayout 
	title={`${event.data.namaAcara} | Padoru Event Notif`} 
	description={`${event.data.namaAcara} - ${event.data.lokasi}, ${event.data.area}`}
	activeNav="events"
>
	<a href="/events" class="back-link">← Back to Events</a>
	
	<article class="event-detail">
		<header class="event-header">
			<span class="event-date-badge">{event.data.tanggal}</span>
			<h1 class="event-title">{event.data.namaAcara}</h1>
			<div class="event-meta">
				<span class="meta-item">📍 {event.data.lokasi}</span>
				<span class="meta-divider">•</span>
				<span class="meta-item">🏙️ {event.data.area}</span>
				{event.data.jam && (
					<>
						<span class="meta-divider">•</span>
						<span class="meta-item">🕐 {event.data.jam}</span>
					</>
				)}
			</div>
		</header>

		<div class="info-card">
			<h2>Event Details</h2>
			<dl class="info-list">
				<div class="info-item">
					<dt>📅 Date</dt>
					<dd>{event.data.tanggal}</dd>
				</div>
				{event.data.jam && (
					<div class="info-item">
						<dt>🕐 Time</dt>
						<dd>{event.data.jam}</dd>
					</div>
				)}
				<div class="info-item">
					<dt>📍 Location</dt>
					<dd>{event.data.lokasi}</dd>
				</div>
				<div class="info-item">
					<dt>🏙️ City</dt>
					<dd>{event.data.area}</dd>
				</div>
				{event.data.lastUpdate && (
					<div class="info-item">
						<dt>🔄 Updated</dt>
						<dd>{event.data.lastUpdate}</dd>
					</div>
				)}
			</dl>
			
			<a href={event.data.linkAcara} target="_blank" rel="noopener noreferrer" class="cta-button">
				View Event Page
				<span>→</span>
			</a>
		</div>

		{relatedEvents.length > 0 && (
			<section class="related-section">
				<h2>More in {event.data.area}</h2>
				<div class="related-grid">
					{relatedEvents.map(related => (
						<a href={`/events/event-${related.id.replace('event-', '')}`} class="related-card">
							<span class="related-date">{related.data.tanggal}</span>
							<h3 class="related-title">{related.data.namaAcara}</h3>
							<span class="related-location">{related.data.lokasi}</span>
						</a>
					))}
				</div>
			</section>
		)}
	</article>
</BaseLayout>

<style>
	.back-link {
		display: inline-block;
		color: var(--text-muted);
		text-decoration: none;
		font-size: 0.9rem;
		margin-bottom: 24px;
		transition: color 0.2s ease;
	}

	.back-link:hover {
		color: var(--text);
	}

	.event-detail {
		max-width: 800px;
	}

	.event-header {
		margin-bottom: 32px;
	}

	.event-date-badge {
		display: inline-block;
		background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
		color: white;
		padding: 8px 16px;
		border-radius: 8px;
		font-size: 0.875rem;
		font-weight: 600;
		margin-bottom: 16px;
	}

	.event-title {
		font-size: 2.25rem;
		font-weight: 700;
		line-height: 1.2;
		margin-bottom: 16px;
	}

	.event-meta {
		display: flex;
		align-items: center;
		gap: 12px;
		flex-wrap: wrap;
		color: var(--text-muted);
	}

	.meta-divider {
		color: var(--border);
	}

	.info-card {
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: 16px;
		padding: 32px;
		margin-bottom: 40px;
	}

	.info-card h2 {
		font-size: 1.25rem;
		font-weight: 600;
		margin-bottom: 24px;
	}

	.info-list {
		margin: 0 0 32px;
	}

	.info-item {
		display: flex;
		justify-content: space-between;
		padding: 16px 0;
		border-bottom: 1px solid var(--border);
	}

	.info-item:last-child {
		border-bottom: none;
	}

	.info-item dt {
		color: var(--text-muted);
	}

	.info-item dd {
		font-weight: 500;
		text-align: right;
	}

	.cta-button {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		width: 100%;
		justify-content: center;
		padding: 16px 28px;
		background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
		color: white;
		text-decoration: none;
		border-radius: 12px;
		font-weight: 600;
		transition: all 0.2s ease;
	}

	.cta-button:hover {
		transform: translateY(-2px);
		box-shadow: 0 8px 30px rgba(99, 102, 241, 0.4);
	}

	.related-section {
		margin-top: 60px;
	}

	.related-section h2 {
		font-size: 1.5rem;
		font-weight: 600;
		margin-bottom: 24px;
	}

	.related-grid {
		display: grid;
		gap: 16px;
	}

	.related-card {
		display: block;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: 12px;
		padding: 20px;
		text-decoration: none;
		color: inherit;
		transition: all 0.2s ease;
	}

	.related-card:hover {
		border-color: var(--primary);
		transform: translateX(4px);
	}

	.related-date {
		color: var(--primary);
		font-size: 0.85rem;
		font-weight: 600;
	}

	.related-title {
		font-size: 1.1rem;
		font-weight: 600;
		margin: 8px 0;
	}

	.related-location {
		color: var(--text-muted);
		font-size: 0.9rem;
	}

	@media (max-width: 640px) {
		.event-title {
			font-size: 1.75rem;
		}

		.info-card {
			padding: 24px;
		}

		.info-item {
			flex-direction: column;
			gap: 4px;
		}

		.info-item dd {
			text-align: left;
		}
	}
</style>
