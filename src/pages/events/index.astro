---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const events = (await getCollection('eventMetadata')).sort((a, b) => {
	// Parse date strings and compare (newest first)
	const dateA = new Date(a.data.tanggal.replace(/(\d{1,2}) (\w{3}) (\d{4})/, '$2 $1, $3'));
	const dateB = new Date(b.data.tanggal.replace(/(\d{1,2}) (\w{3}) (\d{4})/, '$2 $1, $3'));
	return dateB.getTime() - dateA.getTime();
});
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${SITE_TITLE} - Events`} description="List of events" />
		<link rel="stylesheet" href="src/styles/events.css" />
	</head>
	<body>
		<!-- Custom Header -->
		<header class="custom-header">
			<nav class="custom-nav">
				<a href="/" class="brand-logo">Padoru Event Notif</a>
				<div class="nav-links">
					<a href="/" class="nav-link">Home</a>
					<a href="/events" class="nav-link active">Events</a>
					<a href="/about" class="nav-link">About</a>
				</div>
			</nav>
		</header>
		<main>
			<section class="hero-section">
				<h1 class="hero-title">🎪 Upcoming Events</h1>
				<p class="hero-subtitle">
					Discover the latest cosplay events, gaming conventions, and entertainment gatherings
					in Indonesia. Stay updated with real-time information from community sources.
				</p>
				<div class="stats-bar">
					<div class="stat-item">
						<span class="stat-number">{events.length}</span>
						<span class="stat-label">Events</span>
					</div>
					<div class="stat-item">
						<span class="stat-number">{Array.from(new Set(events.map(e => e.data.area))).length}</span>
						<span class="stat-label">Cities</span>
					</div>
					<div class="stat-item">
						<span class="stat-number">📅</span>
						<span class="stat-label">Updated Daily</span>
					</div>
				</div>
			</section>

			<section class="events-section">
				<div class="section-header">
					<h2 class="section-title">All Events</h2>
					<p class="section-subtitle">Sorted by date - newest first</p>
				</div>

				<ul class="events-grid">
					{
						events.map((event) => (
							<li class="card horizontal hoverable" onclick={`window.open('${event.data.linkAcara}', '_blank')`} style="cursor: pointer;">
								<div class="card-stacked">
									<div class="card-content">
										<p class="tgl">{event.data.tanggal}</p>
										<h3 class="title">{event.data.namaAcara}</h3>
										<p class="subtitle">{event.data.lokasi} • {event.data.area}</p>
										{event.data.jam && <p class="subtitle">Time: {event.data.jam}</p>}
										{/* <div class="chip truncate" style="background: linear-gradient(135deg, #219ebc, #8ecae6); color: #023047;">
											🎭 Event
										</div> */}
									</div>
								</div>
								<div class="card-image valign-wrapper">
									<div class="img waves-effect waves-light" style="background-image: url('/IMG_5027.JPG');">
									</div>
								</div>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<!-- Custom Footer -->
		<footer class="custom-footer">
			<div class="footer-content">
				<p class="footer-text">&copy; 2025 Padoru Event Notif. All rights reserved.</p>
				<div class="footer-links">
					<a href="/" class="footer-link">Home</a>
					<a href="/events" class="footer-link">Events</a>
					<a href="/about" class="footer-link">About</a>
				</div>
			</div>
		</footer>
	</body>
</html>
