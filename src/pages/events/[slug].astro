---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getUniqueAreas } from '../../utils/eventUtils';

export async function getStaticPaths() {
	const events = await getCollection('eventMetadata');
	return events.map((event, index) => ({
		params: { slug: `event-${event.id.replace('event-', '')}` },
		props: { event, allEvents: events, index },
	}));
}

const { event, allEvents, index } = Astro.props;
const uniqueAreas = getUniqueAreas(allEvents);

// Get related events (same area, different event)
const relatedEvents = allEvents
	.filter(e => e.data.area === event.data.area && e.id !== event.id)
	.slice(0, 3);
---

<BaseLayout 
	title={`${event.data.namaAcara} | Padoru Event Notif`} 
	description={`${event.data.namaAcara} - ${event.data.lokasi}, ${event.data.area}`}
	activeNav="events"
>
	<article class="event-detail">
		<a href="/events" class="back-link">← Back to Events</a>
		
		<header class="event-header">
			<p class="event-date">{event.data.tanggal}</p>
			<h1 class="event-title">{event.data.namaAcara}</h1>
			<div class="event-meta">
				<span class="meta-item">📍 {event.data.lokasi}</span>
				<span class="meta-item">🏙️ {event.data.area}</span>
				{event.data.jam && <span class="meta-item">🕐 {event.data.jam}</span>}
			</div>
		</header>

		<div class="event-image-container">
			<div class="event-hero-image" style="background-image: url('/IMG_5027.JPG');"></div>
		</div>

		<div class="event-content">
			<section class="event-info">
				<h2>Event Details</h2>
				<dl class="info-list">
					<div class="info-item">
						<dt>📅 Date</dt>
						<dd>{event.data.tanggal}</dd>
					</div>
					{event.data.jam && (
						<div class="info-item">
							<dt>🕐 Time</dt>
							<dd>{event.data.jam}</dd>
						</div>
					)}
					<div class="info-item">
						<dt>📍 Location</dt>
						<dd>{event.data.lokasi}</dd>
					</div>
					<div class="info-item">
						<dt>🏙️ City</dt>
						<dd>{event.data.area}</dd>
					</div>
					{event.data.lastUpdate && (
						<div class="info-item">
							<dt>🔄 Last Update</dt>
							<dd>{event.data.lastUpdate}</dd>
						</div>
					)}
				</dl>
			</section>

			<div class="event-actions">
				<a href={event.data.linkAcara} target="_blank" rel="noopener noreferrer" class="cta-button">
					View Event Page →
				</a>
			</div>
		</div>

		{relatedEvents.length > 0 && (
			<section class="related-events">
				<h2>More Events in {event.data.area}</h2>
				<div class="related-grid">
					{relatedEvents.map(related => (
						<a href={`/events/event-${related.id.replace('event-', '')}`} class="related-card">
							<p class="related-date">{related.data.tanggal}</p>
							<h3 class="related-title">{related.data.namaAcara}</h3>
							<p class="related-location">{related.data.lokasi}</p>
						</a>
					))}
				</div>
			</section>
		)}
	</article>
</BaseLayout>

<style>
	.event-detail {
		max-width: 900px;
		margin: 0 auto;
	}

	.back-link {
		display: inline-block;
		color: #219ebc;
		text-decoration: none;
		font-weight: 500;
		margin-bottom: 20px;
		transition: color 0.3s ease;
	}

	.back-link:hover {
		color: #023047;
	}

	.event-header {
		text-align: center;
		margin-bottom: 30px;
	}

	.event-date {
		color: #219ebc;
		font-weight: 600;
		font-size: 1rem;
		text-transform: uppercase;
		letter-spacing: 1px;
		margin: 0 0 15px 0;
	}

	.event-title {
		font-size: 2.5rem;
		font-weight: 600;
		color: #023047;
		margin: 0 0 20px 0;
		line-height: 1.2;
	}

	.event-meta {
		display: flex;
		justify-content: center;
		gap: 20px;
		flex-wrap: wrap;
	}

	.meta-item {
		color: #666;
		font-size: 1rem;
	}

	.event-image-container {
		margin-bottom: 30px;
		border-radius: 16px;
		overflow: hidden;
		box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
	}

	.event-hero-image {
		width: 100%;
		height: 400px;
		background-size: cover;
		background-position: center;
	}

	.event-content {
		background: white;
		border-radius: 16px;
		padding: 40px;
		box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
		margin-bottom: 40px;
	}

	.event-info h2 {
		color: #023047;
		font-size: 1.5rem;
		margin: 0 0 20px 0;
	}

	.info-list {
		margin: 0;
	}

	.info-item {
		display: flex;
		gap: 20px;
		padding: 15px 0;
		border-bottom: 1px solid #eee;
	}

	.info-item:last-child {
		border-bottom: none;
	}

	.info-item dt {
		font-weight: 600;
		color: #333;
		min-width: 150px;
	}

	.info-item dd {
		margin: 0;
		color: #666;
	}

	.event-actions {
		margin-top: 30px;
		text-align: center;
	}

	.cta-button {
		display: inline-block;
		padding: 15px 40px;
		background: linear-gradient(135deg, #ffb703, #fb8500);
		color: #023047;
		text-decoration: none;
		border-radius: 30px;
		font-weight: 600;
		font-size: 1.1rem;
		transition: transform 0.3s ease, box-shadow 0.3s ease;
		box-shadow: 0 4px 15px rgba(255, 183, 3, 0.3);
	}

	.cta-button:hover {
		transform: translateY(-2px);
		box-shadow: 0 8px 25px rgba(255, 183, 3, 0.4);
	}

	.related-events {
		background: white;
		border-radius: 16px;
		padding: 40px;
		box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
	}

	.related-events h2 {
		color: #023047;
		font-size: 1.5rem;
		margin: 0 0 25px 0;
		text-align: center;
	}

	.related-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
		gap: 20px;
	}

	.related-card {
		background: #f8f9fa;
		padding: 20px;
		border-radius: 12px;
		text-decoration: none;
		transition: transform 0.3s ease, box-shadow 0.3s ease;
		border: 2px solid transparent;
	}

	.related-card:hover {
		transform: translateY(-3px);
		box-shadow: 0 6px 20px rgba(0, 0, 0, 0.1);
		border-color: #219ebc;
	}

	.related-date {
		color: #219ebc;
		font-size: 0.85rem;
		font-weight: 600;
		margin: 0 0 8px 0;
	}

	.related-title {
		color: #023047;
		font-size: 1.1rem;
		margin: 0 0 8px 0;
		line-height: 1.3;
	}

	.related-location {
		color: #666;
		font-size: 0.9rem;
		margin: 0;
	}

	@media (max-width: 768px) {
		.event-title {
			font-size: 1.8rem;
		}

		.event-meta {
			flex-direction: column;
			gap: 10px;
		}

		.event-hero-image {
			height: 250px;
		}

		.event-content {
			padding: 25px;
		}

		.info-item {
			flex-direction: column;
			gap: 5px;
		}

		.info-item dt {
			min-width: auto;
		}
	}
</style>
