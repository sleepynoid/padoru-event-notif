---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const events = (await getCollection('eventMetadata')).sort((a, b) => {
	// Parse date strings and compare (newest first)
	const dateA = new Date(a.data.tanggal.replace(/(\d{1,2}) (\w{3}) (\d{4})/, '$2 $1, $3'));
	const dateB = new Date(b.data.tanggal.replace(/(\d{1,2}) (\w{3}) (\d{4})/, '$2 $1, $3'));
	return dateB.getTime() - dateA.getTime();
});
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${SITE_TITLE} - Events`} description="List of events" />
		<style>
			main {
				width: 960px;
			}
			ul {
				display: flex;
				flex-wrap: wrap;
				gap: 2rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			ul li {
				width: 100%;
				margin-bottom: 1rem;
				padding: 1rem;
				border: 1px solid rgb(var(--gray));
				border-radius: 8px;
			}
			.title {
				margin: 0 0 0.5rem 0;
				color: rgb(var(--black));
				font-size: 1.5rem;
			}
			.info {
				margin: 0.25rem 0;
				color: rgb(var(--gray));
			}
			.link {
				display: inline-block;
				margin-top: 0.5rem;
				padding: 0.5rem 1rem;
				background: rgb(var(--accent));
				color: white;
				text-decoration: none;
				border-radius: 4px;
			}
			.link:hover {
				background: rgb(var(--accent-dark));
			}
			.text-link {
				color: rgb(var(--accent));
				text-decoration: underline;
				word-break: break-all;
			}
			.text-link:hover {
				color: rgb(var(--accent-dark));
			}
			@media (max-width: 720px) {
				main {
					width: 100%;
					padding: 1rem;
				}
				ul li {
					padding: 0.5rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section>
				<h1>Events</h1>
				<ul>
					{
						events.map((event) => (
							<li>
								<h2 class="title">{event.data.namaAcara}</h2>
								<p class="info"><strong>Date:</strong> {event.data.tanggal}</p>
								{event.data.jam && <p class="info"><strong>Time:</strong> {event.data.jam}</p>}
								<p class="info"><strong>Location:</strong> {event.data.lokasi}</p>
								<p class="info"><strong>Area:</strong> {event.data.area}</p>
				<p class="info"><strong>Last Update:</strong> {event.data.lastUpdate}</p>
				{event.data.linkAcara && (
					<p class="info">
						<strong>Link:</strong>
						<a class="text-link" href={event.data.linkAcara} target="_blank" rel="noopener noreferrer">
							{event.data.linkAcara}
						</a>
					</p>
				)}
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
