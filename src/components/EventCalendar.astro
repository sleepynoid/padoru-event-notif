---
import type { Event } from "../types/event";
import { parseEventDate } from "../utils/dateUtils";

interface Props {
	events: Event[];
}

const { events } = Astro.props;

// Prepare all events data for client-side use
const allEventsData = events.map((e) => {
	const date = parseEventDate(e.tanggal);
	return {
		id: e.id,
		nama_acara: e.nama_acara,
		lokasi: e.lokasi,
		jam: e.jam,
		link_acara: e.link_acara,
		tanggal: e.tanggal,
		year: date?.getFullYear() || null,
		month: date?.getMonth() ?? null,
		day: date?.getDate() || null,
	};
});

const dayNames = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];
const monthNames = [
	"January",
	"February",
	"March",
	"April",
	"May",
	"June",
	"July",
	"August",
	"September",
	"October",
	"November",
	"December",
];
---

<div class="calendar-container">
	<div class="calendar-header">
		<button class="nav-btn" id="prev-month" aria-label="Previous month"
			>←</button
		>
		<h3 class="calendar-title" id="calendar-title">📅 Loading...</h3>
		<button class="nav-btn" id="next-month" aria-label="Next month"
			>→</button
		>
	</div>
	<span class="event-count" id="event-count">0 days with events</span>

	<div class="calendar-grid" id="calendar-grid">
		{dayNames.map((day) => <div class="calendar-day-header">{day}</div>)}
		<!-- Days will be generated by JavaScript -->
	</div>

	<div class="calendar-legend">
		<span class="legend-dot"></span>
		<span class="legend-text">Click on highlighted days to see events</span>
	</div>
</div>

<!-- Event Popup Modal -->
<div class="event-popup" id="event-popup">
	<div class="popup-content">
		<div class="popup-header">
			<h4 class="popup-title" id="popup-title">Events on Date</h4>
			<button class="popup-close" id="popup-close">✕</button>
		</div>
		<div class="popup-body" id="popup-body">
			<!-- Events will be inserted here -->
		</div>
	</div>
</div>

<script define:vars={{ allEventsData, monthNames }}>
	let currentYear = new Date().getFullYear();
	let currentMonth = new Date().getMonth();

	const calendarGrid = document.getElementById("calendar-grid");
	const calendarTitle = document.getElementById("calendar-title");
	const eventCount = document.getElementById("event-count");
	const prevBtn = document.getElementById("prev-month");
	const nextBtn = document.getElementById("next-month");
	const popup = document.getElementById("event-popup");
	const popupTitle = document.getElementById("popup-title");
	const popupBody = document.getElementById("popup-body");
	const popupClose = document.getElementById("popup-close");

	function getEventsForMonth(year, month) {
		const eventsByDay = new Map();
		allEventsData.forEach((event) => {
			if (event.year === year && event.month === month) {
				if (!eventsByDay.has(event.day)) {
					eventsByDay.set(event.day, []);
				}
				eventsByDay.get(event.day).push(event);
			}
		});
		return eventsByDay;
	}

	function renderCalendar() {
		const firstDay = new Date(currentYear, currentMonth, 1);
		const lastDay = new Date(currentYear, currentMonth + 1, 0);
		const daysInMonth = lastDay.getDate();
		const startingDayOfWeek = firstDay.getDay();

		const eventsByDay = getEventsForMonth(currentYear, currentMonth);
		const today = new Date();
		const isCurrentMonth =
			today.getMonth() === currentMonth &&
			today.getFullYear() === currentYear;
		const todayDate = today.getDate();

		// Update title
		if (calendarTitle) {
			calendarTitle.textContent = `📅 ${monthNames[currentMonth]} ${currentYear}`;
		}

		// Update event count
		if (eventCount) {
			eventCount.textContent = `${eventsByDay.size} days with events`;
		}

		// Clear existing days (keep headers)
		const headers = calendarGrid?.querySelectorAll(".calendar-day-header");
		const existingDays = calendarGrid?.querySelectorAll(".calendar-day");
		existingDays?.forEach((day) => day.remove());

		// Generate empty slots
		for (let i = 0; i < startingDayOfWeek; i++) {
			const emptyDay = document.createElement("div");
			emptyDay.className = "calendar-day empty";
			calendarGrid?.appendChild(emptyDay);
		}

		// Generate days
		for (let day = 1; day <= daysInMonth; day++) {
			const dayEl = document.createElement("div");
			const dayEvents = eventsByDay.get(day) || [];
			const hasEvents = dayEvents.length > 0;
			const isToday = isCurrentMonth && day === todayDate;

			dayEl.className = "calendar-day";
			if (hasEvents) dayEl.classList.add("has-events");
			if (isToday) dayEl.classList.add("is-today");

			dayEl.innerHTML = `
				<span class="day-number">${day}</span>
				${
					hasEvents
						? `
					<div class="event-dots">
						${dayEvents
							.slice(0, 3)
							.map(() => '<span class="event-dot"></span>')
							.join("")}
						${dayEvents.length > 3 ? `<span class="more-events">+${dayEvents.length - 3}</span>` : ""}
					</div>
				`
						: ""
				}
			`;

			if (hasEvents) {
				dayEl.addEventListener("click", () =>
					showPopup(day, dayEvents),
				);
			}

			calendarGrid?.appendChild(dayEl);
		}
	}

	function showPopup(day, events) {
		if (popupTitle) {
			popupTitle.textContent = `Events on ${day} ${monthNames[currentMonth]} ${currentYear}`;
		}

		if (popupBody) {
			popupBody.innerHTML = events
				.map(
					(event) => `
				<a href="${event.link_acara}" target="_blank" class="popup-event">
					<div class="popup-event-name">${event.nama_acara}</div>
					<div class="popup-event-details">
						<span>📍 ${event.lokasi}</span>
						${event.jam ? `<span>🕐 ${event.jam}</span>` : ""}
					</div>
				</a>
			`,
				)
				.join("");
		}

		popup?.classList.add("show");
	}

	prevBtn?.addEventListener("click", () => {
		currentMonth--;
		if (currentMonth < 0) {
			currentMonth = 11;
			currentYear--;
		}
		renderCalendar();
	});

	nextBtn?.addEventListener("click", () => {
		currentMonth++;
		if (currentMonth > 11) {
			currentMonth = 0;
			currentYear++;
		}
		renderCalendar();
	});

	popupClose?.addEventListener("click", () => {
		popup?.classList.remove("show");
	});

	popup?.addEventListener("click", (e) => {
		if (e.target === popup) {
			popup.classList.remove("show");
		}
	});

	document.addEventListener("keydown", (e) => {
		if (e.key === "Escape") {
			popup?.classList.remove("show");
		}
	});

	// Initial render
	renderCalendar();
</script>

<style is:global>
	.calendar-container {
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: 16px;
		padding: 24px;
		margin-bottom: 32px;
	}

	.calendar-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 12px;
		gap: 12px;
	}

	.nav-btn {
		background: var(--surface-light);
		border: 1px solid var(--border);
		color: var(--text);
		width: 40px;
		height: 40px;
		border-radius: 10px;
		cursor: pointer;
		font-size: 1.25rem;
		display: flex;
		align-items: center;
		justify-content: center;
		transition: all 0.2s ease;
	}

	.nav-btn:hover {
		background: var(--primary);
		color: white;
		border-color: var(--primary);
	}

	.calendar-title {
		font-size: 1.25rem;
		font-weight: 600;
		margin: 0;
		text-align: center;
		flex: 1;
	}

	.event-count {
		display: block;
		color: var(--text-muted);
		font-size: 0.875rem;
		text-align: center;
		margin-bottom: 16px;
	}

	.calendar-grid {
		display: grid;
		grid-template-columns: repeat(7, 1fr);
		gap: 4px;
	}

	.calendar-day-header {
		text-align: center;
		font-size: 0.75rem;
		font-weight: 600;
		color: var(--text-muted);
		padding: 8px 0;
		text-transform: uppercase;
	}

	.calendar-day {
		aspect-ratio: 1;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		padding: 4px;
		border-radius: 8px;
		position: relative;
		cursor: default;
		transition: all 0.2s ease;
		min-height: 44px;
	}

	.calendar-day.empty {
		background: transparent;
	}

	.calendar-day:not(.empty):hover {
		background: var(--surface-light);
	}

	.calendar-day.has-events {
		background: rgba(99, 102, 241, 0.1);
		cursor: pointer;
	}

	.calendar-day.has-events:hover {
		background: rgba(99, 102, 241, 0.25);
		transform: scale(1.05);
	}

	.calendar-day.is-today {
		border: 2px solid var(--primary);
	}

	.calendar-day.is-today .day-number {
		font-weight: 700;
		color: var(--primary);
	}

	.day-number {
		font-size: 0.9rem;
		font-weight: 500;
	}

	.event-dots {
		display: flex;
		gap: 2px;
		margin-top: 4px;
		align-items: center;
	}

	.event-dot {
		width: 6px;
		height: 6px;
		background: var(--primary);
		border-radius: 50%;
	}

	.more-events {
		font-size: 0.6rem;
		color: var(--primary);
		font-weight: 600;
	}

	.calendar-legend {
		display: flex;
		align-items: center;
		gap: 8px;
		margin-top: 16px;
		padding-top: 16px;
		border-top: 1px solid var(--border);
	}

	.legend-dot {
		width: 10px;
		height: 10px;
		background: var(--primary);
		border-radius: 50%;
	}

	.legend-text {
		font-size: 0.8rem;
		color: var(--text-muted);
	}

	/* Event Popup Modal */
	.event-popup {
		display: none;
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		background: rgba(0, 0, 0, 0.7);
		z-index: 1000;
		align-items: center;
		justify-content: center;
		padding: 20px;
	}

	.event-popup.show {
		display: flex;
	}

	.popup-content {
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: 16px;
		max-width: 480px;
		width: 100%;
		max-height: 80vh;
		overflow: hidden;
		display: flex;
		flex-direction: column;
		animation: popupIn 0.2s ease;
	}

	@keyframes popupIn {
		from {
			opacity: 0;
			transform: scale(0.95) translateY(-10px);
		}
		to {
			opacity: 1;
			transform: scale(1) translateY(0);
		}
	}

	.popup-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 20px 24px;
		border-bottom: 1px solid var(--border);
	}

	.popup-title {
		font-size: 1.1rem;
		font-weight: 600;
		margin: 0;
	}

	.popup-close {
		background: var(--surface-light);
		border: 1px solid var(--border);
		color: var(--text);
		width: 32px;
		height: 32px;
		border-radius: 8px;
		cursor: pointer;
		font-size: 1rem;
		display: flex;
		align-items: center;
		justify-content: center;
		transition: all 0.2s ease;
	}

	.popup-close:hover {
		background: var(--primary);
		color: white;
		border-color: var(--primary);
	}

	.popup-body {
		padding: 16px 24px 24px;
		overflow-y: auto;
		display: flex;
		flex-direction: column;
		gap: 12px;
	}

	.popup-event {
		display: block;
		background: var(--surface-light);
		border: 1px solid var(--border);
		border-radius: 12px;
		padding: 16px;
		text-decoration: none;
		color: inherit;
		transition: all 0.2s ease;
	}

	.popup-event:hover {
		border-color: var(--primary);
		transform: translateX(4px);
	}

	.popup-event-name {
		font-weight: 600;
		font-size: 1rem;
		margin-bottom: 8px;
		color: var(--text);
	}

	.popup-event-details {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		font-size: 0.85rem;
		color: var(--text-muted);
	}

	@media (max-width: 640px) {
		.calendar-container {
			padding: 12px;
			margin-bottom: 24px;
			overflow-x: hidden;
		}

		.calendar-header {
			gap: 8px;
		}

		.nav-btn {
			width: 32px;
			height: 32px;
			font-size: 0.9rem;
			flex-shrink: 0;
		}

		.calendar-title {
			font-size: 0.9rem;
			white-space: nowrap;
			overflow: hidden;
			text-overflow: ellipsis;
		}

		.event-count {
			font-size: 0.75rem;
			margin-bottom: 12px;
		}

		.calendar-grid {
			gap: 2px;
		}

		.calendar-day-header {
			font-size: 0.6rem;
			padding: 4px 0;
		}

		.calendar-day {
			min-height: 32px;
			padding: 2px;
			border-radius: 6px;
		}

		.calendar-day.has-events:hover {
			transform: none;
		}

		.day-number {
			font-size: 0.7rem;
		}

		.event-dots {
			margin-top: 2px;
		}

		.event-dot {
			width: 3px;
			height: 3px;
		}

		.more-events {
			font-size: 0.5rem;
		}

		.calendar-legend {
			margin-top: 12px;
			padding-top: 12px;
		}

		.legend-dot {
			width: 8px;
			height: 8px;
		}

		.legend-text {
			font-size: 0.7rem;
		}

		.popup-content {
			max-height: 90vh;
			max-width: calc(100vw - 32px);
		}

		.popup-header {
			padding: 14px 16px;
		}

		.popup-title {
			font-size: 1rem;
		}

		.popup-body {
			padding: 12px 16px 16px;
		}

		.popup-event {
			padding: 12px;
		}

		.popup-event-name {
			font-size: 0.9rem;
		}

		.popup-event-details {
			font-size: 0.75rem;
			gap: 8px;
		}
	}

	@media (max-width: 360px) {
		.calendar-container {
			padding: 8px;
			border-radius: 12px;
		}

		.calendar-title {
			font-size: 0.8rem;
		}

		.nav-btn {
			width: 28px;
			height: 28px;
			font-size: 0.8rem;
		}

		.calendar-day {
			min-height: 28px;
		}

		.day-number {
			font-size: 0.65rem;
		}

		.event-dot {
			width: 2px;
			height: 2px;
		}
	}
</style>
