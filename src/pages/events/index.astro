---
import { getDb } from '../../db';
import { events as eventsTable } from '../../db/schema';
import BaseLayout from '../../layouts/BaseLayout.astro';
import EventCard from '../../components/EventCard.astro';
import EventCalendar from '../../components/EventCalendar.astro';
import { sortByDate, getUniqueAreas } from '../../utils/eventUtils';

const { db, close } = getDb(Astro.locals);
let allEvents: any[] = [];

try {
	allEvents = await db.select().from(eventsTable);
} finally {
	close();
}

const events = sortByDate(allEvents, 'desc');
const uniqueAreas = getUniqueAreas(events);
---

<BaseLayout title="Events | Padoru Event Notif" description="List of upcoming events" activeNav="events">
	<section class="page-header">
		<h1 class="page-title">Upcoming Events</h1>
		<p class="page-subtitle">
			{events.length} events tersedia di {uniqueAreas.length} kota
		</p>
	</section>

	<EventCalendar events={allEvents} />

	<section class="filter-section">
		<div class="search-wrapper">
			<span class="search-icon">🔍</span>
			<input 
				type="text" 
				id="event-search" 
				class="search-input" 
				placeholder="Search events..."
			/>
		</div>
		<select id="area-filter" class="filter-select">
			<option value="all">All Cities</option>
			{uniqueAreas.map(area => (
				<option value={area.toLowerCase()}>{area}</option>
			))}
		</select>
	</section>

	<div class="events-grid">
		{
			events.map((event) => (
				<EventCard
					tanggal={event.tanggal}
					nama_acara={event.nama_acara}
					lokasi={event.lokasi}
					area={event.area}
					jam={event.jam}
					link_acara={event.link_acara}
					last_update={event.last_update}
				/>
			))
		}
	</div>

	<p class="no-results" id="no-results" style="display: none;">
		No events found matching your search.
	</p>
</BaseLayout>

<script>
	const searchInput = document.getElementById('event-search') as HTMLInputElement;
	const areaFilter = document.getElementById('area-filter') as HTMLSelectElement;
	const eventCards = document.querySelectorAll('.event-card');
	const noResults = document.getElementById('no-results');

	function filterEvents() {
		const searchQuery = searchInput?.value.toLowerCase() || '';
		const selectedArea = areaFilter?.value || 'all';
		let visibleCount = 0;

		eventCards.forEach((card) => {
			const htmlCard = card as HTMLElement;
			const title = htmlCard.querySelector('.event-title')?.textContent?.toLowerCase() || '';
			const location = htmlCard.querySelector('.event-location')?.textContent?.toLowerCase() || '';
			const area = htmlCard.querySelector('.event-area')?.textContent?.toLowerCase() || '';

			const matchesSearch = !searchQuery || 
				title.includes(searchQuery) || 
				location.includes(searchQuery);
			
			const matchesArea = selectedArea === 'all' || 
				area.includes(selectedArea.toLowerCase());

			if (matchesSearch && matchesArea) {
				htmlCard.style.display = '';
				visibleCount++;
			} else {
				htmlCard.style.display = 'none';
			}
		});

		if (noResults) {
			noResults.style.display = visibleCount === 0 ? 'block' : 'none';
		}
	}

	searchInput?.addEventListener('input', filterEvents);
	areaFilter?.addEventListener('change', filterEvents);
</script>

<style>
	.page-header {
		margin-bottom: 40px;
	}

	.page-title {
		font-size: 2.5rem;
		font-weight: 700;
		margin-bottom: 8px;
	}

	.page-subtitle {
		color: var(--text-muted);
		font-size: 1rem;
	}

	.filter-section {
		display: flex;
		gap: 16px;
		margin-bottom: 32px;
		flex-wrap: wrap;
		width: 100%;
		max-width: 100%;
	}

	.search-wrapper {
		flex: 1 1 300px;
		min-width: 0;
		max-width: 100%;
		position: relative;
	}

	.search-icon {
		position: absolute;
		left: 16px;
		top: 50%;
		transform: translateY(-50%);
		font-size: 1rem;
	}

	.search-input {
		width: 90%;
		padding: 14px 16px 14px 48px;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: 12px;
		color: var(--text);
		font-size: 1rem;
		outline: none;
		transition: border-color 0.2s ease;
	}

	.search-input::placeholder {
		color: var(--text-muted);
	}

	.search-input:focus {
		border-color: var(--primary);
	}

	.filter-select {
		padding: 14px 20px;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: 12px;
		color: var(--text);
		font-size: 1rem;
		cursor: pointer;
		outline: none;
		min-width: 150px;
	}

	.filter-select:focus {
		border-color: var(--primary);
	}

	.events-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
		gap: 20px;
	}

	.no-results {
		text-align: center;
		color: var(--text-muted);
		padding: 60px 20px;
		font-size: 1.1rem;
	}

	@media (max-width: 640px) {
		.page-title {
			font-size: 2rem;
		}

		.filter-section {
			flex-direction: column;
		}

		.search-wrapper {
			flex: none;
			width: 100%;
		}

		.filter-select {
			width: 100%;
			min-width: auto;
		}

		.events-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
