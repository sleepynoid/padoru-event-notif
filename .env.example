# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-key

# Google Sheets URL for event data
GOOGLE_SHEET_URL=https://docs.google.com/spreadsheets/d/YOUR_SPREADSHEET_ID/edit?gid=YOUR_GID

# Sync Secret (for protecting /api/sync endpoint)
SYNC_SECRET=your-random-secret-token

# Site URL for production (used for sitemap, RSS, etc.)
SITE_URL=http://localhost:4321
