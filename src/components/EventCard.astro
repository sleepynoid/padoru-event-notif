---
interface Props {
	tanggal: string;
	namaAcara: string;
	lokasi: string;
	area: string;
	jam?: string;
	linkAcara: string;
	imageUrl?: string;
	lastUpdate?: string;
}

const { 
	tanggal, 
	namaAcara, 
	lokasi, 
	area, 
	jam, 
	linkAcara, 
	lastUpdate 
} = Astro.props;
---

<article class="event-card" onclick={`window.open('${linkAcara}', '_blank')`}>
	<div class="event-header">
		<span class="event-date">{tanggal}</span>
		{jam && <span class="event-time">{jam}</span>}
	</div>
	<h3 class="event-title">{namaAcara}</h3>
	<div class="event-location">
		<span class="location-icon">📍</span>
		<span>{lokasi}</span>
	</div>
	<div class="event-footer">
		<span class="event-area">{area}</span>
		<span class="event-arrow">→</span>
	</div>
</article>

<style>
	.event-card {
		background: var(--surface, #1a1a1a);
		border: 1px solid var(--border, #2a2a2a);
		border-radius: 16px;
		padding: 24px;
		cursor: pointer;
		transition: all 0.2s ease;
		display: flex;
		flex-direction: column;
		gap: 12px;
	}

	.event-card:hover {
		border-color: var(--primary, #6366f1);
		transform: translateY(-2px);
		box-shadow: 0 8px 30px rgba(0, 0, 0, 0.3);
	}

	.event-header {
		display: flex;
		align-items: center;
		gap: 12px;
		flex-wrap: wrap;
	}

	.event-date {
		background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
		color: white;
		padding: 6px 12px;
		border-radius: 8px;
		font-size: 0.8rem;
		font-weight: 600;
	}

	.event-time {
		color: var(--text-muted, #a1a1aa);
		font-size: 0.875rem;
	}

	.event-title {
		font-size: 1.25rem;
		font-weight: 600;
		color: var(--text, #ffffff);
		line-height: 1.3;
		margin: 4px 0;
	}

	.event-location {
		display: flex;
		align-items: center;
		gap: 8px;
		color: var(--text-muted, #a1a1aa);
		font-size: 0.9rem;
	}

	.location-icon {
		font-size: 1rem;
	}

	.event-footer {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-top: auto;
		padding-top: 12px;
		border-top: 1px solid var(--border, #2a2a2a);
	}

	.event-area {
		background: var(--surface-light, #242424);
		padding: 6px 12px;
		border-radius: 6px;
		font-size: 0.8rem;
		color: var(--text-muted, #a1a1aa);
	}

	.event-arrow {
		color: var(--primary, #6366f1);
		font-size: 1.25rem;
		transition: transform 0.2s ease;
	}

	.event-card:hover .event-arrow {
		transform: translateX(4px);
	}
</style>
