---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About | Padoru Event Notif" description="About Padoru Event Notif" activeNav="about">
	<section class="about-section">
		<h1 class="about-title">About Padoru Event Notif</h1>
		<div class="about-content">
			<p>
				Padoru Event Notif is a comprehensive platform dedicated to keeping the Indonesian community
				informed about the latest events, particularly in the cosplay, gaming, and entertainment sectors.
				Our mission is to bridge the gap between event organizers and attendees by providing accurate,
				up-to-date information in an easily accessible format.
			</p>

			<h2>Our Mission</h2>
			<p>
				We believe that everyone should have access to timely and accurate event information. By
				aggregating data from various sources and presenting it in a clean, organized manner, we aim
				to enhance the community experience and support the growth of local events and conventions.
			</p>

			<h2>Key Features</h2>
			<div class="feature-list">
				<div class="feature-item">
					<h3>📊 Data Aggregation</h3>
					<p>Automatically collect and organize event data from multiple sources including community spreadsheets.</p>
				</div>
				<div class="feature-item">
					<h3>🔄 Real-time Updates</h3>
					<p>Stay current with the latest event information through our automated update system.</p>
				</div>
				<div class="feature-item">
					<h3>🎯 Community Focus</h3>
					<p>Dedicated to serving the Indonesian cosplay, gaming, and entertainment communities.</p>
				</div>
				<div class="feature-item">
					<h3>📱 Mobile Friendly</h3>
					<p>Responsive design that works perfectly on all devices, from phones to desktops.</p>
				</div>
			</div>

			<h2>Technology</h2>
			<p>
				Built with modern web technologies including Astro for optimal performance, this platform
				delivers fast loading times and a smooth user experience. Our system integrates with Google
				Sheets for data management and ensures reliability and accuracy in all event information.
			</p>

			<p>
				Thank you for choosing Padoru Event Notif as your go-to source for event information.
				We are committed to continuously improving our platform to better serve our community.
			</p>
		</div>
	</section>
</BaseLayout>

<style>
	.about-section {
		background: white;
		border-radius: 12px;
		padding: 40px;
		box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
		margin-bottom: 40px;
	}

	.about-title {
		font-size: 2.5rem;
		font-weight: 300;
		color: #333;
		text-align: center;
		margin-bottom: 30px;
	}

	.about-content {
		max-width: 800px;
		margin: 0 auto;
	}

	.about-content p {
		color: #666;
		line-height: 1.8;
		margin-bottom: 20px;
		font-size: 1.1rem;
	}

	.about-content h2 {
		color: #023047;
		font-size: 1.8rem;
		font-weight: 500;
		margin: 40px 0 20px 0;
	}

	.feature-list {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
		gap: 20px;
		margin: 30px 0;
	}

	.feature-item {
		background: #f8f9fa;
		padding: 20px;
		border-radius: 8px;
		border-left: 4px solid #219ebc;
	}

	.feature-item h3 {
		color: #023047;
		font-size: 1.2rem;
		margin: 0 0 10px 0;
	}

	.feature-item p {
		color: #666;
		margin: 0;
		font-size: 0.95rem;
	}

	@media (max-width: 768px) {
		.about-section {
			padding: 20px;
		}

		.about-title {
			font-size: 2rem;
		}

		.feature-list {
			grid-template-columns: 1fr;
		}
	}
</style>
