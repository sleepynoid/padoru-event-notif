---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import EventCard from '../../components/EventCard.astro';
import EventFilter from '../../components/EventFilter.astro';
import { sortByDate, getUniqueAreas } from '../../utils/eventUtils';

const allEvents = await getCollection('eventMetadata');
const events = sortByDate(allEvents, 'desc');
const uniqueAreas = getUniqueAreas(events);
---

<BaseLayout title="Events | Padoru Event Notif" description="List of upcoming events" activeNav="events">
	<section class="hero-section">
		<h1 class="hero-title">🎪 Upcoming Events</h1>
		<p class="hero-subtitle">
			Discover the latest cosplay events, gaming conventions, and entertainment gatherings
			in Indonesia. Stay updated with real-time information from community sources.
		</p>
		<div class="stats-bar">
			<div class="stat-item">
				<span class="stat-number">{events.length}</span>
				<span class="stat-label">Events</span>
			</div>
			<div class="stat-item">
				<span class="stat-number">{uniqueAreas.length}</span>
				<span class="stat-label">Cities</span>
			</div>
			<div class="stat-item">
				<span class="stat-number">📅</span>
				<span class="stat-label">Updated Daily</span>
			</div>
		</div>
	</section>

	<EventFilter areas={uniqueAreas} />

	<section class="events-section">
		<div class="section-header">
			<h2 class="section-title">All Events</h2>
			<p class="section-subtitle">Sorted by date - newest first</p>
		</div>

		<div class="events-grid">
			{
				events.map((event) => (
					<EventCard
						tanggal={event.data.tanggal}
						namaAcara={event.data.namaAcara}
						lokasi={event.data.lokasi}
						area={event.data.area}
						jam={event.data.jam}
						linkAcara={event.data.linkAcara}
						lastUpdate={event.data.lastUpdate}
					/>
				))
			}
		</div>
	</section>
</BaseLayout>

<style>
	/* Hero Section */
	.hero-section {
		text-align: center;
		margin-bottom: 40px;
		padding: 60px 20px;
		background: white;
		border-radius: 16px;
		box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
	}

	.hero-title {
		font-size: 3.5rem;
		font-weight: 300;
		color: #333;
		margin-bottom: 20px;
		background: linear-gradient(135deg, #023047, #219ebc);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}

	.hero-subtitle {
		font-size: 1.2rem;
		color: #666;
		margin-bottom: 40px;
		line-height: 1.6;
		max-width: 600px;
		margin-left: auto;
		margin-right: auto;
	}

	.stats-bar {
		display: flex;
		justify-content: center;
		gap: 40px;
		margin-top: 30px;
	}

	.stat-item {
		text-align: center;
	}

	.stat-number {
		display: block;
		font-size: 2.5rem;
		font-weight: 700;
		color: #219ebc;
		line-height: 1;
	}

	.stat-label {
		display: block;
		font-size: 0.9rem;
		color: #666;
		text-transform: uppercase;
		letter-spacing: 1px;
		margin-top: 5px;
	}

	/* Events Section */
	.events-section {
		margin-top: 0;
	}

	.section-header {
		text-align: center;
		margin-bottom: 30px;
	}

	.section-title {
		font-size: 2.2rem;
		font-weight: 400;
		color: #333;
		margin-bottom: 10px;
	}

	.section-subtitle {
		font-size: 1rem;
		color: #666;
		margin: 0;
	}

	/* Events Grid */
	.events-grid {
		display: flex;
		flex-direction: column;
		gap: 16px;
	}

	@media (max-width: 768px) {
		.hero-section {
			padding: 40px 20px;
		}

		.hero-title {
			font-size: 2.5rem;
		}

		.stats-bar {
			gap: 20px;
		}

		.stat-number {
			font-size: 2rem;
		}
	}
</style>
