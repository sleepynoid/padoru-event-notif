---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout activeNav="home">
	<section class="hero-section">
		<h1 class="hero-title">🎉 Padoru Event Notif</h1>
		<p class="hero-subtitle">
			Welcome to Padoru Event Notif, your go-to source for the latest event information in Indonesia.
			We aggregate and organize event data from various sources to keep you updated on upcoming
			cosplay events, gaming conventions, and entertainment gatherings.
		</p>
		<a href="/events" class="cta-button">Explore Events</a>
	</section>

	<section class="features-section">
		<div class="feature-card">
			<div class="feature-icon">📅</div>
			<h3 class="feature-title">Real-time Updates</h3>
			<p class="feature-description">Automatically fetch and update event information from Google Sheets for the latest data.</p>
		</div>
		<div class="feature-card">
			<div class="feature-icon">🎨</div>
			<h3 class="feature-title">Modern Design</h3>
			<p class="feature-description">Beautiful, responsive design with a professional blue theme that works on all devices.</p>
		</div>
		<div class="feature-card">
			<div class="feature-icon">🔍</div>
			<h3 class="feature-title">Easy Navigation</h3>
			<p class="feature-description">Intuitive event listings with detailed information and direct links to event pages.</p>
		</div>
		<div class="feature-card">
			<div class="feature-icon">⚡</div>
			<h3 class="feature-title">Fast & Reliable</h3>
			<p class="feature-description">Built with Astro for optimal performance and lightning-fast loading times.</p>
		</div>
	</section>
</BaseLayout>

<style>
	.hero-section {
		text-align: center;
		margin-bottom: 60px;
	}

	.hero-title {
		font-size: 3rem;
		font-weight: 300;
		color: #333;
		margin-bottom: 20px;
	}

	.hero-subtitle {
		font-size: 1.2rem;
		color: #666;
		margin-bottom: 30px;
		line-height: 1.6;
	}

	.cta-button {
		display: inline-block;
		padding: 15px 30px;
		background: linear-gradient(135deg, #ffb703, #fb8500);
		color: #023047;
		text-decoration: none;
		border-radius: 25px;
		font-weight: 600;
		font-size: 1.1rem;
		transition: transform 0.3s ease, box-shadow 0.3s ease;
		box-shadow: 0 4px 15px rgba(255, 183, 3, 0.3);
	}

	.cta-button:hover {
		transform: translateY(-2px);
		box-shadow: 0 8px 25px rgba(255, 183, 3, 0.4);
	}

	.features-section {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: 30px;
		margin: 60px 0;
	}

	.feature-card {
		background: white;
		padding: 30px;
		border-radius: 12px;
		box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
		text-align: center;
		transition: transform 0.3s ease;
	}

	.feature-card:hover {
		transform: translateY(-5px);
	}

	.feature-icon {
		font-size: 3rem;
		margin-bottom: 20px;
	}

	.feature-title {
		font-size: 1.3rem;
		font-weight: 600;
		color: #333;
		margin-bottom: 15px;
	}

	.feature-description {
		color: #666;
		line-height: 1.6;
	}

	@media (max-width: 768px) {
		.hero-title {
			font-size: 2.5rem;
		}

		.hero-subtitle {
			font-size: 1.1rem;
		}

		.features-section {
			grid-template-columns: 1fr;
			gap: 20px;
		}
	}
</style>
