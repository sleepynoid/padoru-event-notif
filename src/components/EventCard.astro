---
interface Props {
	tanggal: string;
	namaAcara: string;
	lokasi: string;
	area: string;
	jam?: string;
	linkAcara: string;
	imageUrl?: string;
	lastUpdate?: string;
}

const { 
	tanggal, 
	namaAcara, 
	lokasi, 
	area, 
	jam, 
	linkAcara, 
	imageUrl = '/IMG_5027.JPG',
	lastUpdate 
} = Astro.props;
---

<article class="event-card" onclick={`window.open('${linkAcara}', '_blank')`}>
	<div class="event-content">
		<p class="event-date">{tanggal}</p>
		<h3 class="event-title">{namaAcara}</h3>
		<p class="event-location">📍 {lokasi} • {area}</p>
		{jam && <p class="event-time">🕐 {jam}</p>}
		{lastUpdate && <p class="event-update">Updated: {lastUpdate}</p>}
	</div>
	<div class="event-image">
		<div class="event-img" style={`background-image: url('${imageUrl}');`}></div>
	</div>
</article>

<style>
	.event-card {
		display: flex;
		background-color: #fff;
		border-radius: 16px;
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
		overflow: hidden;
		min-height: 200px;
		cursor: pointer;
		transition: box-shadow 0.25s, transform 0.25s;
	}

	.event-card:hover {
		box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
		transform: translateY(-2px);
	}

	.event-content {
		padding: 24px;
		flex: 1;
		display: flex;
		flex-direction: column;
		justify-content: center;
	}

	.event-date {
		color: #219ebc;
		font-weight: 600;
		font-size: 0.9rem;
		margin: 0 0 8px 0;
		text-transform: uppercase;
		letter-spacing: 0.5px;
	}

	.event-title {
		font-size: 1.4rem;
		font-weight: 600;
		color: #023047;
		margin: 0 0 12px 0;
		line-height: 1.3;
	}

	.event-location {
		color: #666;
		font-size: 0.95rem;
		margin: 0 0 8px 0;
	}

	.event-time {
		color: #888;
		font-size: 0.9rem;
		margin: 0;
	}

	.event-update {
		color: #aaa;
		font-size: 0.8rem;
		margin: 8px 0 0 0;
		font-style: italic;
	}

	.event-image {
		flex: 0 0 280px;
		padding: 16px;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.event-img {
		width: 100%;
		height: 100%;
		border-radius: 12px;
		background-size: cover;
		background-position: center;
		background-repeat: no-repeat;
		box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
		transition: transform 0.3s ease;
		min-height: 168px;
	}

	.event-img:hover {
		transform: scale(1.02);
	}

	@media (max-width: 768px) {
		.event-card {
			flex-direction: column;
			min-height: auto;
		}

		.event-image {
			flex: none;
			height: 200px;
			order: -1;
		}

		.event-content {
			padding: 20px;
		}

		.event-title {
			font-size: 1.2rem;
		}
	}
</style>
