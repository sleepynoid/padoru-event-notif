---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About | Padoru Event Notif" description="About Padoru Event Notif" activeNav="about">
	<section class="page-header">
		<h1 class="page-title">About</h1>
		<p class="page-subtitle">Platform event notifier untuk komunitas Indonesia</p>
	</section>

	<div class="content-grid">
		<article class="content-card">
			<h2>🎯 Mission</h2>
			<p>
				Padoru Event Notif hadir untuk memudahkan komunitas anime, cosplay, dan gaming 
				di Indonesia dalam menemukan event-event yang mereka cari. Kami mengumpulkan 
				informasi dari berbagai sumber dan menyajikannya dalam format yang mudah diakses.
			</p>
		</article>

		<article class="content-card">
			<h2>📊 Data Source</h2>
			<p>
				Data event dikumpulkan dari spreadsheet komunitas yang dikelola oleh volunteer. 
				Update dilakukan secara otomatis setiap hari untuk memastikan informasi selalu akurat.
			</p>
		</article>

		<article class="content-card">
			<h2>⚡ Technology</h2>
			<p>
				Dibangun dengan Astro untuk performa optimal. Static site generation 
				memastikan loading time yang cepat di semua device dan koneksi internet.
			</p>
		</article>

		<article class="content-card">
			<h2>🤝 Community</h2>
			<p>
				Project open source ini berkembang berkat kontribusi komunitas. 
				Jika kamu menemukan bug atau ingin menambahkan fitur, feel free untuk berkontribusi!
			</p>
		</article>
	</div>

	<section class="cta-section">
		<h2>Ready to explore?</h2>
		<p>Temukan event-event menarik di sekitarmu</p>
		<a href="/events" class="cta-button">
			Browse Events
			<span>→</span>
		</a>
	</section>
</BaseLayout>

<style>
	.page-header {
		margin-bottom: 48px;
	}

	.page-title {
		font-size: 2.5rem;
		font-weight: 700;
		margin-bottom: 8px;
	}

	.page-subtitle {
		color: var(--text-muted);
		font-size: 1.1rem;
	}

	.content-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: 24px;
	}

	.content-card {
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: 16px;
		padding: 28px;
		transition: border-color 0.2s ease;
	}

	.content-card:hover {
		border-color: var(--primary);
	}

	.content-card h2 {
		font-size: 1.25rem;
		font-weight: 600;
		margin-bottom: 12px;
	}

	.content-card p {
		color: var(--text-muted);
		line-height: 1.7;
		font-size: 0.95rem;
	}

	.cta-section {
		text-align: center;
		margin-top: 80px;
		padding: 60px 40px;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: 20px;
	}

	.cta-section h2 {
		font-size: 1.75rem;
		font-weight: 600;
		margin-bottom: 8px;
	}

	.cta-section p {
		color: var(--text-muted);
		margin-bottom: 24px;
	}

	.cta-button {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 14px 28px;
		background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
		color: white;
		text-decoration: none;
		border-radius: 12px;
		font-weight: 600;
		transition: all 0.2s ease;
	}

	.cta-button:hover {
		transform: translateY(-2px);
		box-shadow: 0 8px 30px rgba(99, 102, 241, 0.4);
	}

	@media (max-width: 640px) {
		.page-title {
			font-size: 2rem;
		}

		.cta-section {
			padding: 40px 24px;
		}
	}
</style>
