---
import { getCollection, getEntry } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

export async function getStaticPaths() {
	const events = await getCollection('eventMetadata');
	return events.map((event) => ({
		params: { slug: event.id },
		props: { event },
	}));
}

const { event } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${event.data.namaAcara} | ${SITE_TITLE}`} description={`Event details for ${event.data.namaAcara}`} />
		<style>
			main {
				width: 960px;
			}
			.event-details {
				padding: 2rem;
				border: 1px solid rgb(var(--gray));
				border-radius: 8px;
				margin: 2rem 0;
			}
			.title {
				margin: 0 0 1rem 0;
				color: rgb(var(--black));
				font-size: 2rem;
			}
			.info {
				margin: 0.5rem 0;
				font-size: 1.1rem;
			}
			.label {
				font-weight: bold;
				color: rgb(var(--accent));
			}
			.link {
				display: inline-block;
				margin-top: 1rem;
				padding: 0.75rem 1.5rem;
				background: rgb(var(--accent));
				color: white;
				text-decoration: none;
				border-radius: 4px;
				font-weight: bold;
			}
			.link:hover {
				background: rgb(var(--accent-dark));
			}
			.text-link {
				color: rgb(var(--accent));
				text-decoration: underline;
				word-break: break-all;
			}
			.text-link:hover {
				color: rgb(var(--accent-dark));
			}
			.back-link {
				display: inline-block;
				margin-bottom: 2rem;
				color: rgb(var(--accent));
				text-decoration: none;
			}
			.back-link:hover {
				text-decoration: underline;
			}
			@media (max-width: 720px) {
				main {
					width: 100%;
					padding: 1rem;
				}
				.event-details {
					padding: 1rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<a class="back-link" href="/events/">← Back to Events</a>
			<section class="event-details">
				<h1 class="title">{event.data.namaAcara}</h1>
				<p class="info"><span class="label">Date:</span> {event.data.tanggal}</p>
				{event.data.jam && <p class="info"><span class="label">Time:</span> {event.data.jam}</p>}
				<p class="info"><span class="label">Location:</span> {event.data.lokasi}</p>
				<p class="info"><span class="label">Area:</span> {event.data.area}</p>
				<p class="info"><span class="label">Last Update:</span> {event.data.lastUpdate}</p>
				<p class="info">
					<span class="label">Link:</span>
					<a class="text-link" href={event.data.linkAcara} target="_blank" rel="noopener noreferrer">
						{event.data.linkAcara}
					</a>
				</p>
				{event.data.linkAcara && (
					<a class="link" href={event.data.linkAcara} target="_blank" rel="noopener noreferrer">
						View Event Details
					</a>
				)}
			</section>
		</main>
		<Footer />
	</body>
</html>
